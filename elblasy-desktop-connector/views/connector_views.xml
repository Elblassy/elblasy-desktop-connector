<odoo>
    <record id="res_config_settings_view_form_desktop_connector" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.desktop.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- إضافة الحقول مباشرة في الإعدادات العامة -->
            <xpath expr="//div[contains(@class, 'settings')]" position="inside">
                <div class="row mt16">
                    <div class="col-12">
                        <label for="desktop_connection_enabled">Enable Desktop Connection</label>
                        <field name="desktop_connection_enabled" class="mt-2"/>
                    </div>
                </div>

                <div class="row mt16" attrs="{'invisible': [('desktop_connection_enabled', '=', False)]}">
                    <div class="col-12">
                        <label for="connection_code">Connection Code</label>
                        <field name="connection_code" class="mt-2" readonly="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>